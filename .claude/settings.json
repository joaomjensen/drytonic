{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "tonic guard \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "tonic check \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ]
  }
}
